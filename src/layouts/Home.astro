---
import ToggleTheme from "@/components/ToggleTheme";
import BaseLayout from "./BaseLayout.astro";
import PageFind from "@/components/PageFind";
import config from "../config";
---

<!-- ========================================
     主页布局组件
     
     布局结构说明：
     - 桌面端 (>1010px): 左右两栏布局
       - 左侧: 导航栏 + 头像 + 社交链接 + 暗黑模式切换
       - 右侧: 内容区 (GitHub 日历 + 文章列表)
     - 移动端 (<1010px): 单栏布局 + 抽屉式导航
       - 顶栏: 汉堡菜单 + 标题 + 暗黑模式切换
       - 导航: 默认隐藏，点击汉堡菜单展开抽屉
       - 内容: 文章列表 (日历隐藏)
     ======================================== -->
<BaseLayout
  title={Astro.props.title
    ? `${Astro.props.title} | ${config.title}`
    : config.title}
>
  <div>
    <div class="lg:flex home">
      <!-- ========================================
           桌面端导航栏 (仅 >1010px 显示)
           包含: 头像、名称、签名、暗黑模式切换、导航链接
           ======================================== -->
      <div id="pc-container" class="sm:px-10 lg:mt-10 py-20 desktop nav-view">
        <div class="sticky top-5 flex flex-col gap-4">
          <!-- 头像 -->
          <!-- 
            头像容器说明：
            - w-32 h-32: 固定 128px 尺寸
            - mx-auto: 水平居中
          -->
          <div class="w-32 h-32 inline-block mx-auto">
            <img
              class="rounded w-full h-full object-cover transition-transform duration-700 ease-in-out hover:rotate-[540deg]"
              src="/flower.jpg"
              alt="头像"
            />
          </div>
          <!-- 名称与签名 -->
          <div class="mediate" data-pagefind-ignore>
            <p class="font-bold text-2xl text-foreground-name">{config.name}</p>
            <div class="text-foreground-secondary text-base font-light my-2">
              <div class="flex">
                <!-- 暗黑模式切换按钮 (桌面端) -->
                <div id="theme">
                  <ToggleTheme />
                </div>
                <span class="ml-6 mt-1">{config.signature}</span>
              </div>
            </div>
          </div>

          <!-- 导航链接列表 -->
          <div
            class="flex lg:flex-col gap-4 mx-auto nav-webfont"
            data-pagefind-ignore
          >
            {
              config.navs.map((nav) => {
                const { pathname } = Astro.url;
                const trimmedPathname =
                  pathname === "/" ? pathname : pathname.replace(/\/$/, "");
                const isActive = trimmedPathname === nav.url;
                return (
                  <a
                    href={nav.url}
                    class:list={isActive ? "active" : ""}
                    rel={nav.url.startsWith("http") ? "noopener" : undefined}
                  >
                    {nav.title}
                  </a>
                );
              })
            }
          </div>
          <!-- 博客年份 -->
          <div
            class="text-foreground-muted text-sm mediate"
            data-pagefind-ignore
          >
            Blog since {config.since}
          </div>
        </div>
      </div>

      <!-- ========================================
           移动端抽屉式导航 (仅 <1010px 显示)
           默认隐藏，点击汉堡菜单后滑入显示
           注意: 初始状态不包含 opened-pc 类，抽屉默认隐藏
           ======================================== -->
      <div
        id="mobile-container"
        class="sm:px-10 lg:mt-10 py-20 mobile mobile-menu opened"
      >
        <div class="sticky top-5 flex flex-col gap-4">
          <div class="mediate">
            <!-- 头像 -->
            <!-- 
              头像容器说明（移动端抽屉）：
              - w-32 h-32: 固定 128px 尺寸
              - mx-auto: 水平居中
            -->
            <div class="w-32 h-32 inline-block mx-auto">
              <img
                class="rounded w-full h-full object-cover transition-transform duration-700 ease-in-out hover:rotate-[360deg]"
                src="/flower.jpg"
                alt="头像"
              />
            </div>
            <!-- 名称与签名 -->
            <p class="font-bold text-2xl text-foreground-name font-name">
              {config.name}
            </p>
            <div class="text-foreground-secondary text-base font-light my-2">
              <div class="flex">
                <!-- 暗黑模式切换按钮 (抽屉内) -->
                <div id="theme">
                  <ToggleTheme />
                </div>
                <span class="ml-6 mt-1" style="margin-left:24px"
                  >{config.signature}</span
                >
              </div>
            </div>
          </div>
          <!-- 导航链接列表 -->
          <div
            class="flex lg:flex-col gap-4 mx-auto nav-webfont"
            data-pagefind-ignore
          >
            {
              config.navs.map((nav) => {
                const { pathname } = Astro.url;
                const trimmedPathname =
                  pathname === "/" ? pathname : pathname.replace(/\/$/, "");
                const isActive = trimmedPathname === nav.url;
                return (
                  <a
                    href={nav.url}
                    class:list={isActive ? "active" : ""}
                    rel={nav.url.startsWith("http") ? "noopener" : undefined}
                  >
                    {nav.title}
                  </a>
                );
              })
            }
          </div>
          <!-- 博客年份 -->
          <div
            class="text-foreground-muted text-sm mediate"
            data-pagefind-ignore
          >
            Blog since {config.since}
          </div>
        </div>
      </div>

      <!-- ========================================
           移动端顶部导航栏 (仅 <1010px 显示)
           三栏布局: 汉堡菜单 | 标题 | 暗黑模式切换
           ======================================== -->
      <div
        class="toggle bg-background-secondary/60 mobile header-navbar"
        data-pagefind-ignore
      >
        <!-- 左侧: 汉堡菜单按钮 - 用于展开/收起抽屉导航 -->
        <div class="toggle-menu" id="toggle">
          <i class="iconfont icon-menu"></i>
        </div>
        <!-- 中间: 网站标题 -->
        <div class="header-slogan" data-pagefind-ignore>Hiro's log</div>
        <!-- 右侧: 暗黑模式切换按钮 -->
        <div class="toggle-menu toggle-theme-btn">
          <ToggleTheme />
        </div>
      </div>

      <!-- 移动端遮罩层 - 点击可关闭抽屉导航 -->
      <div id="shading" class="shading container-mains opened"></div>

      <!-- ========================================
           主内容区域
           桌面端: 显示 GitHub 日历 + 文章列表
           移动端: 仅显示文章列表 (日历通过 .desktop 类隐藏)
           ======================================== -->
      <div class="lg:mt-28 ml-52 md container-main opened">
        <div class="container">
          <slot />
        </div>
      </div>

      <!-- 桌面端目录插槽 -->
      <div class="desktop">
        <slot name="catalogue" />
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // TODO: To be optimized
  document.addEventListener("astro:page-load", () => {
    const toggleButton = document.getElementById("toggle");
    const toggleshading = document.getElementById("shading");
    const mobileMenuSelector = ".mobile-menu";
    const containerMainSelector = ".container-main";
    const containerMainSelectors = ".container-mains";
    const headerNavbarSelector = ".header-navbar";
    const headerShading = ".shading";

    if (toggleButton) {
      toggleButton.addEventListener("click", () => {
        const mobileMenu = document.querySelector(mobileMenuSelector);
        const containerMain = document.querySelector(containerMainSelector);
        const containerMains = document.querySelector(containerMainSelectors);
        const headerNavbar = document.querySelector(headerNavbarSelector);
        const mobileheaderShading = document.querySelector(headerShading);

        mobileMenu?.classList.toggle("opened-pc");
        containerMain?.classList.toggle("opened-mobile");
        containerMains?.classList.toggle("opened-mobile");
        headerNavbar?.classList.toggle("opened-mobile");
        mobileheaderShading?.classList.toggle("close-mask");
      });
    }

    if (toggleshading) {
      toggleshading.addEventListener("click", () => {
        const mobileMenu = document.querySelector(mobileMenuSelector);
        const containerMain = document.querySelector(containerMainSelector);
        const containerMains = document.querySelector(containerMainSelectors);
        const headerNavbar = document.querySelector(headerNavbarSelector);
        const mobileheaderShading = document.querySelector(headerShading);

        mobileMenu?.classList.remove("opened-pc");
        containerMain?.classList.remove("opened-mobile");
        containerMains?.classList.remove("opened-mobile");
        headerNavbar?.classList.remove("opened-mobile");
        mobileheaderShading?.classList.remove("close-mask");
      });
    }

    function toggleView() {
      const pcContainer = document.getElementById("pc-container");
      const mobileContainer = document.getElementById("mobile-container");

      if (pcContainer && mobileContainer) {
        if (window.innerWidth > 1010) {
          pcContainer.style.display = "block";
          mobileContainer.style.display = "none";
          mobileContainer.innerHTML = "";
        } else {
          pcContainer.style.display = "none";
          mobileContainer.style.display = "block";
          pcContainer.innerHTML = "";
        }
      }
    }

    window.addEventListener("resize", toggleView);
    toggleView();
  });
</script>

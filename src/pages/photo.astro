---
import TypeWriter from "@/components/vue/TypeWriter";
import Home from "@/layouts/Home";
import Photoalbum from "@/components/vue/Photoalbum";
import config from "../config";
---

<Home title="生活相册">
  <div class="mx-auto text-sm" data-pagefind-ignore>
    <div class="mb-8 flex flex-col gap-1">
      <h1 class="text-xl font-medium mb-4 mt-2">图片/视频</h1>
      <h2 class="text-sm">
        <TypeWriter
          client:only="vue"
          strings={[config.picture]}
          typeSpeed={80}
        />
      </h2>
    </div>
  </div>
  <Photoalbum client:only="vue" />
</Home>

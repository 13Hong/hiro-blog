---
import TypeWriter from "@/components/vue/TypeWriter";
import Home from "@/layouts/Home";
import config from "../config";
// let wx = "https://chetxu.chetserenade.info/article/wx.webp";
---

<Home title="关于我">
  <div class="mx-auto mb-6 text-sm" data-pagefind-ignore>
    <h1 class="text-xl font-medium mb-4 mt-2">About Me</h1>
    <div class="prose-width">
      <!-- 第一段使用打字机效果 -->
      <span>
        👋 <TypeWriter
          client:load
          strings={[
            "Hello, I am Hiro, currently residing in GuangZhou, Guangdong, China.",
            "你好，我是 Hiro，目前居住在中国广东广州。",
          ]}
          typeSpeed={60}
          backSpeed={35}
          backDelay={3000}
          loop={true}
        />
      </span>
      <!-- 其余 span 保持静态 -->
      <span>
        💻 I am a frontend engineer, and my primary tech stack includes Vue,
        Unocss, TypeScript, Tailwind CSS, and Vite.
      </span>
      <span>
        🍻 In my free time, I enjoy exploring various cuisines, playing
        basketball, and Football.</span
      >
      <span>
        🔮 You can see more on<a
          href="https://github.com/13Hong"
          target="_blank">Github</a
        >and<a href="https://juejin.cn/user/1313259659208356" target="_blank"
          >Juejin
        </a>
      </span>
    </div>
    <!-- <div class="mt-2 font-bold text-md">{config.friend}</div> -->

    <!-- <img src={wx} class="w-48 h-48 mt-3" alt="微信" /> -->
  </div>
</Home>
